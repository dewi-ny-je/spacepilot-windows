<Window x:Class="Axial.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Axial.App"
        Title="Axial" Width="1200" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UIFont}" FontSize="13"
        Background="{StaticResource WindowFallbackBrush}">
    <Grid x:Name="Root">
        <Grid x:Name="Layout" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="230" MaxWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="700"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12,10,10,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Image Source="{StaticResource AxialGlyph}" Width="36" Height="36" Margin="0,0,10,0"/>
                        <TextBlock Text="Axial" Style="{StaticResource AppTitle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse x:Name="ServiceDot" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.5"/>
                            <Path x:Name="ServiceCheck" Data="M3.6,7.2 L6,9.5 L10.4,4.6" Stroke="#FF0B2A20" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock x:Name="ServiceText" Text="Service stopped" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}" Margin="0,16"/>
                    <TextBlock Text="APPLICATION PROFILE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                    <ComboBox x:Name="ProfileBox" Style="{StaticResource SidebarCombo}" AutomationProperties.Name="Profile" SelectionChanged="OnProfileChosen"/>
                    <Button x:Name="AddProfileButton" Style="{StaticResource SidebarButton}" HorizontalContentAlignment="Stretch" Click="OnAddProfile" AutomationProperties.Name="Add application profile">
                        <Grid>
                            <TextBlock Text="Add application profile"/>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Data="M0,0 L4.5,4.5 L9,0" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.6"/>
                        </Grid>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AddProfileMenu">
                                <MenuItem Header="Autodesk Fusion" Tag="fusion360.exe" Click="OnAddKnownProfile"/>
                                <MenuItem Header="PrusaSlicer" Tag="prusa-slicer.exe" Click="OnAddKnownProfile"/>
                                <MenuItem Header="FreeCAD" Tag="freecad.exe" Click="OnAddKnownProfile"/>
                                <MenuItem Header="Blender" Tag="blender.exe" Click="OnAddKnownProfile"/>
                                <Separator Style="{StaticResource MenuSeparator}"/>
                                <MenuItem Header="Choose application…" Click="OnChooseApplication"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="CustomizeButton" Content="Customize for this device" Style="{StaticResource SidebarButton}" Click="OnCustomize"/>
                    <Button x:Name="RemoveButton" Content="Remove override" Style="{StaticResource SidebarButton}" Click="OnRemoveProfile"/>
                    <Border Style="{StaticResource Divider}" Margin="0,6,0,16"/>
                    <StackPanel x:Name="DevicePanel" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="M2,5 L10,5 L10,11 L2,11 Z M4,1 L4,5 M8,1 L8,5 M6,11 L6,15" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DeviceName" Style="{StaticResource Headline}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                <Ellipse Fill="{StaticResource GreenBrush}"/>
                                <Path Data="M3.6,7.2 L6,9.5 L10.4,4.6" Stroke="#FF0B2A20" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                            <TextBlock Text="USB connected" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="DeviceBox" Style="{StaticResource SidebarCombo}" AutomationProperties.Name="Device" SelectionChanged="OnDeviceChosen" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="NoDeviceText" Text="Connect a supported USB controller." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False"/>

            <!-- Settings -->
            <Grid Grid.Column="2" Margin="4,4,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="Tabs" Style="{StaticResource Segmented}" SelectedIndex="{Binding Tab, Mode=TwoWay}" AutomationProperties.Name="Settings tabs" Margin="0,0,0,10">
                    <ListBoxItem Content="Motion"/>
                    <ListBoxItem Content="Buttons"/>
                    <ListBoxItem Content="Test"/>
                    <ListBoxItem Content="Service &amp; diagnostics"/>
                </ListBox>
                <Border Grid.Row="1" Background="{StaticResource ContentSurfaceBrush}" BorderBrush="{StaticResource ContentStrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12">
                    <Grid>
                        <local:MotionView x:Name="Motion"/>
                        <local:ButtonsView x:Name="Buttons" Visibility="Collapsed"/>
                        <local:TestView x:Name="Test" Visibility="Collapsed"/>
                        <local:ServiceView x:Name="Service" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <StackPanel x:Name="MessagePanel" Grid.Row="2" Visibility="Collapsed">
                    <Border Style="{StaticResource Divider}" Margin="0,10,0,6"/>
                    <TextBox x:Name="MessageText" Style="{StaticResource SelectableText}" MaxHeight="34" Text="{Binding Message, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
